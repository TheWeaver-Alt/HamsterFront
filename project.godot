; Engine configuration file.
; Defence of Hamsterland: Mech-Pouch Protocol

config_version=5

[application]

config/name="Defence of Hamsterland: Mech-Pouch Protocol"
config/description="2D top-down action tower defense roguelite. 1-2 player local co-op."
run/main_scene="res://scenes/TitleScreen.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.101961, 0.0627451, 0.12549, 1)
boot_splash/show_image=false

[autoload]

PixelArt="*res://autoloads/PixelArt.gd"
Sfx="*res://autoloads/Sfx.gd"
GameManager="*res://autoloads/GameManager.gd"
CardDB="*res://autoloads/CardDB.gd"
JuiceManager="*res://autoloads/JuiceManager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[gui]

common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="rat_block"
2d_physics/layer_3="players"
2d_physics/layer_4="enemies"
2d_physics/layer_5="towers"
2d_physics/layer_6="cliffs"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.101961, 0.0627451, 0.12549, 1)
