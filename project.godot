; Engine configuration file.
; Defence of HamsterFront: Mech-Pouch Protocol

config_version=5

[application]

config/name="Defence of HamsterFront: Mech-Pouch Protocol"
config/description="2D top-down action tower defense roguelite. 1-2 player local co-op. Hamsters in junkyard mechs vs the Under-Scurriers."
run/main_scene="res://scenes/MainArena.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://autoloads/GameManager.gd"
CardDB="*res://autoloads/CardDB.gd"
JuiceManager="*res://autoloads/JuiceManager.gd"
SFX="*res://autoloads/SFX.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="mechs"
2d_physics/layer_3="rats"
2d_physics/layer_4="towers"
2d_physics/layer_5="silo"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.1, 0.08, 0.14, 1)
